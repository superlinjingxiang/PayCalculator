# Configure the real HTTPS origin before production build, for example https://your-domain.example
# Leave blank for local development; canonical URLs and sitemap entries are then omitted.
NEXT_PUBLIC_SITE_URL=

# Enable only where deploy/nginx-preview.conf (or the same PV endpoint contract) is installed.
# First-party page/time only; no identifiers. Generic static hosts must leave false.
NEXT_PUBLIC_PV_ENABLED=false

# Mature self-hosted analytics. Enable only after the same-origin proxy is ready.
# UUID is public, never an admin password. Script and send routes are fixed in code.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Info-flow ads are disabled until an approved provider and slot IDs are available.
# These values are public build-time settings and are embedded in the browser bundle.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_AD_PROVIDER=
NEXT_PUBLIC_AD_RESULT_SLOT=
NEXT_PUBLIC_AD_CONTENT_SLOT=
