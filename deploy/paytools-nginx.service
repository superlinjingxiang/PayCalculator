[Unit]
Description=PayCalculator static preview (independent Nginx)
After=network.target

[Service]
Type=forking
PIDFile=/run/paytools-nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c /srv/paytools/config/nginx.conf
ExecStart=/usr/sbin/nginx -c /srv/paytools/config/nginx.conf
ExecReload=/usr/sbin/nginx -s reload -c /srv/paytools/config/nginx.conf
ExecStop=/bin/kill -s QUIT $MAINPID
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
